--------------------------------------------------------------------------
-- Window 内部方法
--------------------------------------------------------------------------

-- 把实例属性绑定到主题色，SetTheme 时会自动更新
function Window:_bind(inst, prop, key, animate)
	local entry = self._themed[inst]
	if not entry then
		entry = {}
		self._themed[inst] = entry
	end
	entry[prop] = key
	if animate then
		tween(inst, { [prop] = self.Theme[key] }, FAST)
	else
		inst[prop] = self.Theme[key]
	end
end

function Window:_text(parent, props, colorKey)
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	for key, value in pairs(props) do
		label[key] = value
	end
	label.Parent = parent
	self:_bind(label, "TextColor3", colorKey or "Text")
	return label
end

function Window:_emit(flag, value, callback, silent)
	if flag then
		self.Flags[flag] = value
	end
	if callback and not silent then
		task.spawn(callback, value)
	end
end

function Window:_register(flag, element, frame, value)
	element.Frame = frame
	element.Flag = flag
	if flag then
		self.Elements[flag] = element
		self.Flags[flag] = value
	end
	element.Destroy = function()
		if flag and self.Elements[flag] == element then
			self.Elements[flag] = nil
			self.Flags[flag] = nil
		end
		frame:Destroy()
	end
	return element
end

local function hover(win, frame, button)
	button.MouseEnter:Connect(function()
		win:_bind(frame, "BackgroundColor3", "ElementHover", true)
	end)
	button.MouseLeave:Connect(function()
		win:_bind(frame, "BackgroundColor3", "Element", true)
	end)
end

