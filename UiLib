function UILib:CreateWindow(options)
	options = options or {}
	local self = setmetatable({}, Window)

	self.Title = options.Title or "UILib"
	self.Theme = table.clone(UILib.Themes.Dark)
	local themeOption = options.Theme
	if type(themeOption) == "string" then
		themeOption = UILib.Themes[themeOption]
	end
	if type(themeOption) == "table" then
		for key, value in pairs(themeOption) do
			self.Theme[key] = value
		end
	end

	self.Flags = {}
	self.Elements = {}
	self.Tabs = {}
	self.CurrentTab = nil
	self.ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift
	self.Visible = true
	self._themed = setmetatable({}, { __mode = "k" })
	self._connections = {}
	self._minimized = false
	self._notifOrder = 0

