--[[
	UILib - 轻量级 Roblox UI 库 (Luau)

	用法：
		1. 在 ReplicatedStorage 里新建 ModuleScript，命名为 UILib，粘贴本文件内容
		2. 在 StarterPlayerScripts 里新建 LocalScript，参考 Example.client.lua

	API 概览：
		local Window = UILib:CreateWindow({ Title, Size(Vector2), Theme, ToggleKey, Parent, OnClose, MobileButton })
		local Tab    = Window:CreateTab("名称")
		local Sec    = Tab:AddSection("分组")          -- 可选，Section 与 Tab 拥有相同的 Add* 方法

		Tab:AddLabel(text)
		Tab:AddDivider()
		Tab:AddButton({ Name, Callback })
		Tab:AddToggle({ Name, Default, Flag, Callback })
		Tab:AddSlider({ Name, Min, Max, Default, Increment, Suffix, Flag, Callback })
		Tab:AddDropdown({ Name, Options, Default, Multi, Flag, Callback })
		Tab:AddInput({ Name, Default, Placeholder, Numeric, ClearOnFocus, Flag, Callback })
		Tab:AddKeybind({ Name, Default(Enum.KeyCode), Flag, Callback(按下时), ChangedCallback(改键时) })

		每个元素都有 :Get() / :Set(value, silent) / :Destroy()（Button/Label 另有 :SetText）
		初始 Default 不会触发 Callback；之后用户操作或 :Set() 才会触发（silent=true 则不触发）

		Window:Notify({ Title, Content, Duration, Type = "Info"|"Success"|"Warning"|"Error" })
		Window:SetTheme("Dark"|"Light"|"Ocean"|自定义表)
		Window:SetVisible(bool) / Window:Toggle() / Window:SetMinimized(bool)
		Window:SetToggleKey(Enum.KeyCode)
		Window:GetConfig() / Window:LoadConfig(table)   -- 取得/还原所有带 Flag 的元素值
		Window:Destroy()
		Window.Flags[flag]                               -- 实时读取元素当前值
]]

